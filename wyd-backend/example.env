DATABASE_URL_POOLING=postgresql+asyncpg://<username>@localhost-pooling/wyd-chat-app
DATABASE_URL_NO_POOLING=postgresql+asyncpg://<username>@localhost/wyd-chat-app
ENVIRONMENT=dev
CORS_ORIGINS=["http://localhost:5173"]
JWT_SECRET=256bitstring
DB_PASSWORD=some_password
JWT_ACCESS_TOKEN_LIFETIME=time_in_minutes
TEST_DATABASE_URL=postgresql+asyncpg://tests:<DB_PASSWORD>@localhost:5433/db_testing